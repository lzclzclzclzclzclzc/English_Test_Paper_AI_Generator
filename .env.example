# Copy this file to .env and replace the placeholder before a live pipeline run.
# `test` mode is for deterministic frontend integration only; it does not call
# the real AI Engine. Use `development` for the real Parser/Retriever/Reviser/
# Solutioner chain.
BACKEND_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# The development server allows this origin to send the session Cookie.
FRONTEND_ORIGIN=http://localhost:5173

# Keep these paths aligned with the imported question bank and Chroma index.
SQLITE_PATH=data/questions.db
CHROMA_PATH=data/chroma
# After the frontend builds, copy its dist contents here for same-origin hosting.
BACKEND_STATIC_DIR=backend/static

LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# Optional: use CUDA when available; vector retrieval otherwise falls back to CPU.
LLM_MAX_CONCURRENCY=4
