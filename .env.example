LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# ── 支付 / 积分（docs/credits-design.md）──
# 离线 mock（默认 true）：不连支付宝，/api/payment/dev/simulate-paid 模拟付款
PAYMENT_MOCK=true
PAYMENT_ORDER_TTL_SECONDS=300
# 真实支付宝沙盒：PAYMENT_MOCK=false + 下面四项（密钥 PEM 放 keys/，已 gitignore）
ALIPAY_APPID=
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_APP_PRIVATE_KEY_PATH=keys/app_private_key.pem
ALIPAY_PUBLIC_KEY_PATH=keys/alipay_public_key.pem
PAY_RETURN_URL=http://localhost:5173/credits
# 积分赠送
CREDITS_SIGNUP_BONUS=300
CREDITS_DAILY_GRANT=30

