# 复制为 .env 后按需修改。.env 已被 gitignore,不会提交。

# ── 运行模式 ────────────────────────────────────────────────
# true:完全离线,不调支付宝;二维码为 MOCK|xxx 假码,
#      并开放 POST /payapi/dev/simulate-paid/{out_trade_no} 模拟支付成功。
# false:走支付宝沙盒,需配好下方 ALIPAY_* 与 keys/ 密钥。
MOCK_PAY=true

# 设置后跳过主后端登录校验,所有请求视为该用户(本地联调用,主后端不跑时必设)。
# 留空则转发 session_id cookie 到主后端 /api/auth/me 校验。
PAYMENT_DEV_FAKE_USER=

# 主后端地址(校验登录态用)
MAIN_BACKEND_URL=http://localhost:8000

# ── 存储 ────────────────────────────────────────────────────
DB_PATH=data/payment.db

# 订单/二维码有效期(秒),默认 5 分钟
ORDER_TTL_SECONDS=300

# ── 支付宝沙盒(MOCK_PAY=false 时必填)───────────────────────
# 沙盒控制台 https://open.alipay.com/develop/sandbox/app 获取,格式 9021000xxxxxxxx
ALIPAY_APPID=
# 新版沙盒网关(旧域名 openapi.alipaydev.com 已废弃)
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# PEM 格式密钥文件(见 README 密钥格式说明)
ALIPAY_APP_PRIVATE_KEY_PATH=keys/app_private_key.pem
ALIPAY_PUBLIC_KEY_PATH=keys/alipay_public_key.pem
